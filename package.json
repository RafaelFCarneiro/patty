{
  "name": "@rfc0/patty",
  "version": "0.0.0-development",
  "description": "AI-first personal finance manager — MCP server (local-first, encrypted libSQL).",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "patty": "dist/main.js"
  },
  "main": "dist/main.js",
  "files": [
    "dist",
    "drizzle",
    "ui",
    "skills",
    "!skills/**/evals",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelFCarneiro/patty.git"
  },
  "homepage": "https://github.com/RafaelFCarneiro/patty#readme",
  "bugs": {
    "url": "https://github.com/RafaelFCarneiro/patty/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "cross-env PORT=3001 tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src test scripts ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:coverage:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "test:coverage:all": "npm run test:coverage && npm run test:coverage:integration && node scripts/merge-coverage.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm test && npm run test:integration",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "mcp:inspect": "npx @modelcontextprotocol/inspector"
  },
  "ntl": {
    "descriptions": {
      "dev": "Run backend in watch mode (stdio by default; MCP_TRANSPORT=http or PATTY_HTTP=true for REST + MCP on :3001)",
      "build": "Compile TypeScript to dist/",
      "lint": "Lint src/, test/, scripts/ and ui/ with ESLint (style/quality smell rules — part of the gate)",
      "format": "Format the repository with Prettier",
      "format:check": "Check whether files follow Prettier formatting",
      "start": "Run compiled backend",
      "test": "Run only unit tests (Vitest project: unit)",
      "test:integration": "Run MCP integration tests — in-process libSQL DB, no Docker required",
      "test:coverage:integration": "Integration test coverage report (JSON → coverage/.tmp/integration)",
      "test:coverage:all": "Full coverage: unit + integration merged into coverage/index.html",
      "test:all": "Run unit + integration Vitest projects",
      "test:watch": "Run unit tests in watch mode (Vitest project: unit)",
      "typecheck": "Type-check everything, including tests",
      "mcp:inspect": "Open MCP Inspector — connect to http://127.0.0.1:3001/mcp (Streamable HTTP, after `MCP_TRANSPORT=http npm run dev`)"
    }
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/keyring": "^2.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@rfc0/effect-runner": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.8",
    "jsonc-parser": "^3.3.1",
    "neverthrow": "^8.2.0",
    "openapi3-ts": "^4.6.0",
    "remeda": "^2.21.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.68.0",
    "@html-eslint/parser": "^0.68.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.14.0",
    "eslint-plugin-check-file": "^3.3.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.4",
    "semantic-release": "^25.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.21.0",
    "vitest": "^5.1.0"
  }
}
