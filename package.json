{
  "name": "@rafaelfcarneiro/fintrack",
  "version": "0.0.0-development",
  "description": "AI-first personal finance manager — MCP server (local-first, encrypted libSQL).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fintrack": "dist/main.js"
  },
  "main": "dist/main.js",
  "files": [
    "dist",
    "drizzle",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelFCarneiro/fintrack.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "engines": {
    "node": ">=25 <26",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:coverage:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "test:coverage:all": "npm run test:coverage && npm run test:coverage:integration && node scripts/merge-coverage.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm test && npm run test:integration",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "typecheck": "tsc --noEmit",
    "mcp:inspect": "npx @modelcontextprotocol/inspector"
  },
  "ntl": {
    "descriptions": {
      "dev": "Run backend in watch mode (REST + MCP on :3001)",
      "build": "Compile TypeScript to dist/",
      "lint": "Lint src/ with ESLint (style/quality smell rules — part of the gate)",
      "format": "Format the repository with Prettier",
      "format:check": "Check whether files follow Prettier formatting",
      "start": "Run compiled backend",
      "test": "Run only unit tests (Vitest project: unit)",
      "test:integration": "Run MCP integration tests — in-process libSQL DB, no Docker required",
      "test:coverage:integration": "Integration test coverage report (JSON → coverage/.tmp/integration)",
      "test:coverage:all": "Full coverage: unit + integration merged into coverage/index.html",
      "test:all": "Run unit + integration Vitest projects",
      "test:watch": "Run unit tests in watch mode (Vitest project: unit)",
      "typecheck": "Type-check everything, including tests",
      "mcp:inspect": "Open MCP Inspector — connect to http://127.0.0.1:3001/mcp (Streamable HTTP)"
    }
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@napi-rs/keyring": "^1.3.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.3.0",
    "neverthrow": "^8.2.0",
    "openapi3-ts": "^4.6.0",
    "remeda": "^2.21.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^25.9.4",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "prettier": "^3.9.4",
    "semantic-release": "^25.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.21.0",
    "vitest": "^4.1.8"
  }
}
